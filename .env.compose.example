# Copy this file to .env for the Compose deployment. This template contains no secrets.
# Fill each blank with a unique URL-safe random value; do not commit or share .env.
POSTGRES_USER=sorani
POSTGRES_DB=sorani
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# MinIO root user must be 3–20 characters; password must be at least 8 characters.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Separate bucket-scoped application credentials; do not reuse the root pair.
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=
SORANI_SECRET_KEY=
SORANI_S3_BUCKET=sorani-private
SORANI_ENVIRONMENT=development
SORANI_ALLOWED_ORIGINS=["http://localhost:3000"]
SORANI_COOKIE_SECURE=false
SORANI_LOCAL_FILES_ONLY=true
SORANI_NIGHTLY_FEEDBACK_EXPORT_ENABLED=false
SORANI_FEEDBACK_EXPORT_RETENTION_DAYS=7
WEB_BIND=127.0.0.1
WEB_PORT=3000
# Optional SMTP settings are the same as in .env.example. Production requires HTTPS,
# secure cookies, STARTTLS, and explicit public origins; see docs/deployment.md.
