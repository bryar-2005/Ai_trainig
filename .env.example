# Local development settings only. Copy to .env and provide SORANI_SECRET_KEY
# via a secret store or your shell; never commit the real key or credentials.
HF_HOME=./data/cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1
SORANI_ENVIRONMENT=development
SORANI_DATABASE_URL=postgresql+asyncpg://sorani:sorani@localhost:5432/sorani
SORANI_REDIS_URL=redis://localhost:6379/0
SORANI_BROKER_URL=redis://localhost:6379/1
SORANI_ALLOWED_ORIGINS=["http://localhost:3000"]
SORANI_COOKIE_SECURE=false
SORANI_STORAGE_BACKEND=local
SORANI_STORAGE_ROOT=./data/private-storage
SORANI_MODEL_ROOT=./outputs/models
SORANI_LOCAL_FILES_ONLY=true
SORANI_INFERENCE_DEVICE=cpu
