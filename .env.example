# Local development settings only. Copy to .env and provide SORANI_SECRET_KEY
# via a secret store or your shell; never commit the real key or credentials.
HF_HOME=./data/cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1
SORANI_ENVIRONMENT=development
SORANI_DATABASE_URL=postgresql+asyncpg://sorani:sorani@localhost:5432/sorani
SORANI_REDIS_URL=redis://localhost:6379/0
SORANI_BROKER_URL=redis://localhost:6379/1
SORANI_ALLOWED_ORIGINS=["http://localhost:3000"]
SORANI_COOKIE_SECURE=false
SORANI_STORAGE_BACKEND=local
SORANI_STORAGE_ROOT=./data/private-storage
SORANI_MODEL_ROOT=./outputs/models
SORANI_LOCAL_FILES_ONLY=true
SORANI_INFERENCE_DEVICE=cpu
# Nightly exports require both this operator flag and an individual user's opt-in.
SORANI_NIGHTLY_FEEDBACK_EXPORT_ENABLED=false
SORANI_FEEDBACK_EXPORT_RETENTION_DAYS=7
# Optional password reset: configure these together. Use a secret store for passwords.
# SORANI_SMTP_HOST=smtp.example.com
# SORANI_SMTP_PORT=587
# SORANI_SMTP_SENDER=studio@example.com
# SORANI_SMTP_USERNAME=your-smtp-user
# SORANI_SMTP_PASSWORD=provide-via-secret-store
# SORANI_SMTP_STARTTLS=true
# SORANI_PUBLIC_WEB_ORIGIN=https://studio.example.com
# SORANI_RESET_MINUTES=30
# Set on the Next.js server only (shell or web/.env.local), not in browser code:
# INTERNAL_API_ORIGIN=http://127.0.0.1:8000
